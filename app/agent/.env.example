# Variables del módulo de agente (app/agent/), todas con prefijo AGENT_.
# El anfitrión decide cómo cargar esto (uv run --env-file .env, etc.) --
# este archivo es sólo referencia de qué existe y su default.
#
# Las credenciales del proveedor LLM (ANTHROPIC_API_KEY, GOOGLE_CLOUD_API_KEY...)
# NO llevan prefijo AGENT_: son de infraestructura, compartidas con el resto
# del proyecto anfitrión.

# --- Persistencia de checkpoints (app/agent/persistence/) ------------------
# "memory" (dev/tests, se pierde al reiniciar el proceso) o "firestore".
AGENT_STORE_BACKEND=memory
# Sólo si AGENT_STORE_BACKEND=firestore. Vacío = usa Application Default
# Credentials (cuenta de servicio en Cloud Run, `gcloud auth application-default login` local).
AGENT_FIRESTORE_PROJECT=
AGENT_FIRESTORE_DATABASE=(default)
AGENT_FIRESTORE_COLLECTION_PREFIX=agent

# --- LLM (app/agent/llm/) ---------------------------------------------------
# "anthropic" (default), "google" u "openrouter" (requiere OPENROUTER_API_KEY
# y el extra `uv sync --extra agent-openrouter`; el modelo lleva el prefijo
# que OpenRouter espera, p. ej. "anthropic/claude-sonnet-5").
AGENT_LLM_PROVIDER=anthropic
# Modelo por defecto de cada rol, y al que se escala un subagente puntual
# cuando el revisor detecta un problema de razonamiento (ver README.md).
AGENT_LLM_STANDARD_MODEL=claude-sonnet-5
AGENT_LLM_REASONING_MODEL=claude-opus-5
# JSON opcional para overridear provider/modelo de UN rol puntual, p. ej.:
# AGENT_LLM_ROLE_OVERRIDES={"history_researcher": {"provider": "google", "standard": "gemini-2.5-flash"}}
AGENT_LLM_ROLE_OVERRIDES=

# --- Control de loop / human-in-the-loop ------------------------------------
AGENT_MAX_ITERATIONS=3
AGENT_MAX_SUBAGENT_ATTEMPTS=2
AGENT_MAX_CLARIFICATIONS=2
AGENT_RECURSION_LIMIT=40
AGENT_MAX_MESSAGES_IN_STATE=40

# --- Reintentos de red (LLM y tools externas, p. ej. Firestore) -------------
AGENT_RETRY_MAX_ATTEMPTS=4
AGENT_RETRY_INITIAL_INTERVAL=0.5
AGENT_RETRY_BACKOFF_FACTOR=2.0
AGENT_RETRY_MAX_INTERVAL=20.0
AGENT_RETRY_AFTER_CAP=30.0
