# Variables de entorno locales. Este archivo NO se versiona (ver .gitignore).
# Cargarlo con `uv run --env-file .env ...` o exportarlo en la shell antes de
# levantar el servidor.

# --- Proveedor LLM (app/llm/) --------------------------------------------
# Cuál de app/llm/providers/*.py instancia la fábrica (app/llm/factory.py).
# Valores soportados: anthropic | openrouter | google. Default: anthropic.
# Sin proveedor configurado (o mal configurado), app/llm/interpreter.py
# degrada solo al fallback por palabras clave (interpreted_by="keyword_fallback")
# — la demo sigue funcionando igual.
LLM_PROVIDER=openrouter

# Sólo se leen las variables del proveedor elegido arriba; las de los otros
# dos se pueden dejar vacías.

# -- anthropic (default del stack, CLAUDE.md: claude-opus-5) --
ANTHROPIC_API_KEY=12345
ANTHROPIC_MODEL=claude-opus-5

# -- openrouter (sin dependencias extra: implementado con stdlib) --
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=recomendador-mision-de-compra



# -- google (Vertex AI; requiere `uv sync --extra google`) --
# Con GOOGLE_CLOUD_API_KEY presente, el provider usa modo express y este
# valor manda (GOOGLE_CLOUD_PROJECT/LOCATION se ignoran): el SDK google-genai
# arma la URL correcta según qué credencial le pasás, nunca las dos a la vez.
GOOGLE_CLOUD_API_KEY=
GOOGLE_MODEL=gemini-3.7-flash

# Sólo se usan si GOOGLE_CLOUD_API_KEY está vacía (modo OAuth2/ADC).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# No la lee el código: app/llm/providers/google_provider.py deja que el SDK
# arme la URL (regional vs. "global" resuelven a hosts distintos, y mezclar
# api_key con una URL de proyecto da 401). Dejada acá sólo de referencia.
GOOGLE_CLOUD_ENDPOINT=https://aiplatform.googleapis.com/v1/projects/${PROJECT_ID}/locations/global/publishers/google/models/${MODEL_ID}:streamGenerateContent

# Ruta a un JSON de service account. En Cloud Run no hace falta: usa la
# cuenta de servicio adjunta al servicio (Application Default Credentials).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Resto de la app -------------------------------------------------------

# Ruta al SQLite de solo lectura que consume app/db.py.
# Default si se omite: catalog.db en la raíz del repo.
CATALOG_DB_PATH=catalog.db

# Puerto en el que escucha uvicorn. Cloud Run inyecta esta misma variable en
# producción (docs/07-herramientas-y-comandos.md); en local, uvicorn usa 8000
# si se omite.
PORT=8000



LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="pr-slight-dig-98"

# --- Agente de IA (app/agent/) ----------------------------------------------
# Ver app/agent/.env.example y app/agent/README.md para la lista completa y
# qué hace cada una. "memory" alcanza para correr local sin credenciales de
# Firebase (el agente sigue funcionando, sólo pierde memoria entre reinicios).
AGENT_STORE_BACKEND=memory
AGENT_LLM_PROVIDER=openrouter
AGENT_LLM_STANDARD_MODEL=anthropic/claude-sonnet-5
AGENT_LLM_REASONING_MODEL=anthropic/claude-opus-5
s